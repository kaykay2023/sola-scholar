# Copy to .env for local dev; set the same vars in Railway for production.
# DO NOT commit .env (it is gitignored).

# ── Internal auth (V1: HTTP Basic). Required to start the server safely. ──
# Pick a strong password. Clerk-based auth is the V2 plan.
INTERNAL_USER=sola
INTERNAL_PASSWORD=

# ── Storage ──
# Directory that data.json lives in (Railway: mount a Volume here).
DATA_PATH=./data

# ── External APIs (server-side only — never sent to the browser) ──
APOLLO_API_KEY=
PDL_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
HUNTER_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=
OPENAI_API_KEY=

# ── Airtable mirror (optional) ──
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Matches

# ── Clerk (V2 — listed for forward compatibility, not used in V1) ──
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Port (Railway sets this automatically)
PORT=3000

# Lemlist outbound sending (server-side only; do not commit real values)
LEMLIST_API_KEY=your_lemlist_api_key
LEMLIST_CAMPAIGN_ID=your_lemlist_campaign_id
LEMLIST_WEBHOOK_SECRET=your_lemlist_webhook_secret
LEMLIST_API_BASE_URL=https://api.lemlist.com/api
LEMLIST_SYNC_ENABLED=false
LEMLIST_REQUEST_TIMEOUT_MS=10000

# JSON store backups and runtime identity
DATA_BACKUP_DIR=./data/backups
DATA_BACKUP_RETENTION=20
DATA_BACKUP_INTERVAL_MINUTES=0
DATA_BACKUP_ENABLED=true
EXPECTED_INSTANCE_COUNT=1
JSON_STORE_SINGLE_INSTANCE_ACK=true
BUILD_COMMIT=your_git_commit_sha
SOURCE_COMMIT=your_git_commit_sha
APP_VERSION=1.0.0
BUILD_TIME=2026-01-01T00:00:00.000Z

# Pipeline safety and provider resilience
PROVIDER_REQUEST_TIMEOUT_MS=12000
PIPELINE_IDEMPOTENCY_REQUIRED=false
